<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EduMetrics"
        tools:targetApi="31">

        <!-- SplashScreen Activity -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EduMetrics.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.auth.LoginActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.auth.RegisterActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <!-- Student Activities -->
        <activity
            android:name=".activities.student.StudentDashboardActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.student.SubjectListActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.student.SubjectDetailActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.student.QRScannerActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.student.TaskListActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.student.StudentProfileActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.student.JoinClassActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <!-- Faculty Activities -->
        <activity
            android:name=".activities.faculty.FacultyDashboardActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.faculty.ClassManagementActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.faculty.SubjectManagementActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.faculty.QRGeneratorActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.faculty.AttendanceRecordsActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.faculty.TaskManagementActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.faculty.StudentListActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.faculty.ReportActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <activity
            android:name=".activities.faculty.AddMarksActivity"
            android:theme="@style/Theme.EduMetrics.NoActionBar" />

        <!-- FileProvider for PDF sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
